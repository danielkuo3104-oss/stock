          </div>`;
      }).join('');

      const missing = userWatchlist.filter(id => !stockMap.has(id)).length;
      info.textContent = `共關注 ${userWatchlist.length} 檔` + (q ? `，符合搜尋 ${items.length} 檔` : '') + (missing ? `（${missing} 檔查無資料）` : '');
    }

    let detailStockId = null;
    function closeStockDetail() {
      document.getElementById('stockDetailModal').classList.add('hidden');
      detailStockId = null;
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeStockDetail(); });

    function fmtNum(v, d = 2) { return (v === null || v === undefined || isNaN(v)) ? '--' : Number(v).toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d }); }
    function colOf(v) { return v > 0 ? 'text-stockRed' : (v < 0 ? 'text-stockGreen' : 'text-slate-500 dark:text-slate-400'); }
    function fmtHD(d) { return /^\d{4}-\d{2}-\d{2}$/.test(d || '') ? d.replace(/-/g, '/') : (d ? '日期補查中' : '--'); }

    function openStockDetail(id) {
      const s = stockMap.get(id);
      if (!s) return;
      detailStockId = id;
      const hi = highMap[id];
      const col = colOf(s.change);
      const pctTxt = (s.change > 0 && !s.pctStr.startsWith('+')) ? '+' + s.pctStr : s.pctStr;
      const tile = (label, val, sub) => `
        <div class="bg-slate-100 dark:bg-slate-950 p-2.5 rounded-2xl min-w-0">
          <span class="text-[10px] text-slate-500 dark:text-slate-400 block mb-0.5">${label}</span>
          <span class="text-sm sm:text-base font-black font-mono block truncate">${val}</span>
