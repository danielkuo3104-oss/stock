              <span class="${isNaN(hi.gap) ? 'text-slate-400' : (hi.gap >= 0 ? 'text-stockRed' : 'text-stockGreen')} font-bold">距前高 ${isNaN(hi.gap) ? '--' : (hi.gap > 0 ? '+' : '') + hi.gap.toFixed(2) + '%'}</span>
            </div>` : ''}
